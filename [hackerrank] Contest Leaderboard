TYPE: Medium

==> My approach:
--Find the maximum score per hacker per challenge
WITH MaxScore AS (
    SELECT hacker_id 
         , challenge_id
         , MAX(score) AS max_score
    FROM Submissions
    WHERE score != 0
    GROUP BY hacker_id 
           , challenge_id
)
--Calculate total score per hacker
SELECT h.hacker_id
     , h.name
     , SUM(m.max_score) AS total_score
FROM MaxScore AS m 
JOIN Hackers as h 
   ON m.hacker_id = h.hacker_id
GROUP BY h.hacker_id
       , h.name
ORDER BY total_score DESC 
       , hacker_id ;
